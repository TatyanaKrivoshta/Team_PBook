<Window x:Class="PBook_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels1="clr-namespace:PBook_GUI.Viewmodels"
        xmlns:viewmodels="clr-namespace:PBook_GUI.Viewmodels"
        mc:Ignorable="d"
        Title="Телефонная книга" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Label" x:Key="FieldLabelStyle">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldTextStyle">
            <Setter Property="Margin" Value="5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="5">
            <Button Content="Создать" Command="{Binding CreateCommand}" Width="100" Margin="5" />
            <Button Content="Редактировать" Command="{Binding EditCommand}" Width="100" Margin="5" />
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Width="100" Margin="5" />
        </StackPanel>

        <ListBox Grid.Column="1"
                 ItemsSource="{Binding Contacts}"
                 SelectedItem="{Binding SelectedContact}"
                 Margin="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding FullName}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="2" Margin="5">
            <Label Content="Фамилия:" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding SelectedContact.LastName, Mode=OneWay}"
                       Style="{StaticResource FieldTextStyle}" />
            <Label Content="Имя:" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding SelectedContact.FirstName, Mode=OneWay}"
                       Style="{StaticResource FieldTextStyle}" />
            <Label Content="Отчество:" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding SelectedContact.Patronymic, Mode=OneWay}"
                       Style="{StaticResource FieldTextStyle}" />
            <Label Content="Телефон:" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding SelectedContact.Number, Mode=OneWay}" Style="{StaticResource FieldTextStyle}" />
            <Label Content="Тип телефона:" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding SelectedContact.Type, Mode=OneWay}" Style="{StaticResource FieldTextStyle}" />
        </StackPanel>
    </Grid>
</Window>
